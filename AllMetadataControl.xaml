<UserControl x:Class="ExifToolUI.AllMetadataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExifToolUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <GroupBox Header="All Metadata" DockPanel.Dock="Top" Margin="5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                    <Label Margin="5,0,0,0">Choose file:</Label>
                    <TextBox x:Name="FilePathText" Width="500" Height="20" Margin="5,0,0,0" TextChanged="FilePathTextChanged"/>
                    <Button x:Name="ChooseFileButton" Click="ChooseFileButton_Click" Margin="5,0,0,0">...</Button>
                    <Button x:Name="ExtractButton" Click="ExtractButton_Click" Margin="5,0,0,0" IsEnabled="False">Extract</Button>
                </StackPanel>
                <DataGrid x:Name="MetadataDataGrid" AutoGenerateColumns="False" Margin="5" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tag" Binding="{Binding Key}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseDoubleClick" Handler="MetadataDataGridRow_DoubleClick"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
