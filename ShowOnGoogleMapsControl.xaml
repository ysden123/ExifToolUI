<UserControl x:Class="ExifToolUI.ShowOnGoogleMapsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExifToolUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
        <GroupBox Header="Show on Google Maps" Margin="5">
            <StackPanel Orientation="Horizontal">
                <Label Margin="5" Height="30">Choose file:</Label>
                <TextBox x:Name="FilePathText" Width="500" Height="20" Margin="5,0,0,0" TextChanged="FilePathTextChanged"/>
                <Button x:Name="ChooseFileButton" Click="ChooseFileButton_Click" Margin="5,0,0,0" Height="20">...</Button>
                <Button x:Name="ShowButton" Click="ShowButton_Click" Margin="5,0,0,0" IsEnabled="False" Height="20">Show on map</Button>
            </StackPanel>
        </GroupBox>
</UserControl>
